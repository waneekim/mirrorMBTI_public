{
  "name": "mirror-mbti",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "predev": "npm run setup:mediapipe",
    "dev": "vite",
    "dev:phone": "npm run setup:mediapipe && vite --mode phone",
    "prebuild": "npm run setup:mediapipe",
    "build": "tsc -b && vite build",
